rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    function isStaf() {
      return isAuthenticated() && (getUserData().role == 'staf' || isSuperAdmin());
    }

    function isTutor() {
      return isAuthenticated() && (getUserData().role == 'tutor' || isSuperAdmin());
    }

    function isSiswa() {
      return isAuthenticated() && getUserData().role == 'siswa';
    }

    // Koleksi users
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Siswa mendaftar: role otomatis siswa dan aktif true
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'siswa'
                    && request.resource.data.aktif == true;
      // Update data sendiri (tanpa mengubah role dan aktif), atau Super Admin
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.aktif == resource.data.aktif
      );
      allow delete: if isSuperAdmin();
    }

    // Koleksi program
    match /program/{programId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Koleksi pendaftaran
    match /pendaftaran/{pendaftaranId} {
      // Siswa hanya boleh membaca miliknya sendiri, Staf & Super Admin membaca semua
      allow read: if isStaf() || (isAuthenticated() && resource.data.siswaId == request.auth.uid);
      // Siswa mengajukan: status harus menunggu
      allow create: if isAuthenticated() && request.resource.data.siswaId == request.auth.uid
                    && request.resource.data.status == 'menunggu';
      // Hanya staf dan Super Admin yang boleh mengubah status (misal menyetujui / menolak)
      allow update: if isStaf();
      allow delete: if isSuperAdmin();
    }

    // Koleksi kelas
    match /kelas/{kelasId} {
      // Anggota kelas (siswa), tutor pengampu, staf, dan Super Admin boleh membaca
      allow read: if isStaf()
                  || (isTutor() && resource.data.tutorId == request.auth.uid)
                  || (isAuthenticated() && request.auth.uid in resource.data.siswaIds);
      // Staf dan Super Admin membuat dan mengatur kelas
      allow write: if isStaf();
    }

    // Koleksi pertemuan
    match /pertemuan/{pertemuanId} {
      allow read: if isAuthenticated();
      // Hanya tutor pengampu kelas tersebut dan Super Admin yang boleh mengisi/mengubah pertemuan & presensi
      allow write: if isSuperAdmin() || (
        isTutor() && get(/databases/$(database)/documents/kelas/$(request.resource.data.kelasId)).data.tutorId == request.auth.uid
      );
    }

    // Koleksi tugas
    match /tugas/{tugasId} {
      allow read: if isAuthenticated();
      // Hanya tutor kelas itu dan Super Admin yang boleh membuat tugas
      allow write: if isSuperAdmin() || (
        isTutor() && get(/databases/$(database)/documents/kelas/$(request.resource.data.kelasId)).data.tutorId == request.auth.uid
      );
    }

    // Koleksi pengumpulan
    match /pengumpulan/{pengumpulanId} {
      // Siswa membaca miliknya, Tutor kelas tersebut & Super Admin membaca pengumpulan kelasnya
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.siswaId == request.auth.uid)
                  || (isTutor() && get(/databases/$(database)/documents/kelas/$(resource.data.kelasId)).data.tutorId == request.auth.uid);
      // Siswa mengumpulkan tugasnya
      allow create: if isAuthenticated() && request.resource.data.siswaId == request.auth.uid;
      // Siswa boleh update tautan sebelum dinilai, Tutor boleh update nilai dan komentar
      allow update: if isSuperAdmin()
                    || (isAuthenticated() && resource.data.siswaId == request.auth.uid && !('nilai' in resource.data))
                    || (isTutor() && get(/databases/$(database)/documents/kelas/$(resource.data.kelasId)).data.tutorId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
  }
}
